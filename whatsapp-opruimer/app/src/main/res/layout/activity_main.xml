<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruimt afbeeldingen op waarop geen duidelijk gezicht en geen hond staat. Alles gebeurt op je telefoon; er gaat niets naar internet. Je ziet altijd eerst wat er weg gaat."
            android:textSize="15sp" />

        <TextView
            style="@style/Header"
            android:text="1. Map" />

        <TextView
            android:id="@+id/folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nog geen map gekozen"
            android:textSize="15sp" />

        <Button
            android:id="@+id/pickFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Map kiezen" />

        <CheckBox
            android:id="@+id/subfolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submappen meenemen (zoals Sent en Private)" />

        <TextView
            style="@style/Header"
            android:text="2. Instellingen" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Afbeeldingen van de laatste zoveel dagen overslaan:" />

            <EditText
                android:id="@+id/skipDays"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="4"
                android:text="7" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hoe streng honden herkennen? Voorzichtig bewaart bij twijfel eerder een foto." />

        <RadioGroup
            android:id="@+id/level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/level0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voorzichtig (aanbevolen)" />

            <RadioButton
                android:id="@+id/level1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Normaal" />

            <RadioButton
                android:id="@+id/level2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streng" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/shotsAlways"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screenshots altijd weggooien, ook als er een gezicht of hond op staat" />

        <TextView
            style="@style/Header"
            android:text="3. Scannen" />

        <TextView
            android:id="@+id/permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B00020"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/scan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scannen" />

            <Button
                android:id="@+id/stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stoppen" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp" />

        <TextView
            style="@style/Header"
            android:text="4. Controleren en opruimen" />

        <Button
            android:id="@+id/review"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultaat bekijken" />
    </LinearLayout>
</ScrollView>
